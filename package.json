{
  "name": "qiyu-ember-website",
  "version": "1.0.0",
  "description": "栖屿 Ember 轰趴馆官方网站 - 基于 Node.js + Express 构建的高性能个人博客",
  "main": "server.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "export": "next build",
    "lint": "next lint",
    "old:start": "node server.js",
    "old:dev": "nodemon --watch server.js --watch src --ext js,json server.js"
